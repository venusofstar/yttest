package com.app.honortvph.model

data class Channel(
    val name: String,
    val logo: String,
    val url: String
)









package com.app.honortvph.utils

import com.app.honortvph.model.Channel

fun parseM3U(content: String): List<Channel> {
    val list = mutableListOf<Channel>()

    var name = ""
    var logo = ""

    content.lines().forEach { line ->
        when {
            line.startsWith("#EXTINF") -> {
                name = Regex(",(.+)").find(line)?.groupValues?.get(1) ?: "Unknown"
                logo = Regex("""tvg-logo="([^"]+)"""")
                    .find(line)?.groupValues?.get(1) ?: ""
            }
            line.startsWith("http") -> {
                list.add(Channel(name, logo, line.trim()))
            }
        }
    }
    return list
}





package com.app.honortvph.utils

import okhttp3.OkHttpClient
import okhttp3.Request

fun loadM3U(url: String): String {
    val client = OkHttpClient()
    val request = Request.Builder().url(url).build()
    client.newCall(request).execute().use {
        return it.body?.string() ?: ""
    }
}







